# ─── Supabase Frontend (VITE_* se embeben en el bundle durante el build) ────
# Obtener en: Supabase Dashboard → Project Settings → API
# Estas son "publishable keys" — seguras para el frontend
VITE_SUPABASE_URL=https://XXXXXXXXXX.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ─── Express legacy (solo si se sigue usando el servidor Express) ────────────
# NO requerido para producción frontend-only con Supabase
# DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres
# JWT_SECRET=cambia-esto-en-produccion
# JWT_EXPIRES=7d
# PORT=3001

# ─── CLI de Supabase (solo local, NUNCA en repositorio) ──────────────────────
# Usar `supabase login` en lugar de esta variable de entorno
# SUPABASE_ACCESS_TOKEN=sbp_...
